{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "addresses", "autoAssign"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}(/[0-9]{1,2}|-[0-9]{1,3}(\\.[0-9]{1,3}){3})$"
          }
        },
        "autoAssign": {
          "type": "boolean"
        }
      }
    }
  }
}
