{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "unifi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sites", "verifySsl", "saveSites", "saveDpi", "saveIds"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://[^/]+)?$"
        },
        "sites": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "verifySsl": { "type": "boolean" },
        "saveSites": { "type": "boolean" },
        "saveDpi": { "type": "boolean" },
        "saveIds": { "type": "boolean" }
      }
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "refreshInterval": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["ClusterSecretStore", "SecretStore"] },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "remoteRefs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["username", "password"],
          "properties": {
            "username": { "type": "object" },
            "password": { "type": "object" }
          }
        }
      }
    },
    "dashboards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
