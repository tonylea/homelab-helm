{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loki": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "prometheus": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "tempoOtlpGrpc": {
          "type": "string",
          "pattern": "^([^/:]+:[0-9]+)?$"
        },
        "tempoOtlpHttp": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "syslog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loadBalancerIP": {
              "type": "string",
              "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3})?$"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "port", "protocol", "format", "job"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,13}[a-z0-9])?$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 55535
              },
              "protocol": {
                "enum": ["udp", "tcp"]
              },
              "format": {
                "enum": ["rfc5424", "rfc3164", "raw"]
              },
              "job": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "scrape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["job", "addresses"],
            "properties": {
              "job": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$"
              },
              "addresses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[^/:]+:[0-9]+$"
                }
              },
              "metricsPath": {
                "type": "string",
                "pattern": "^/"
              },
              "scheme": {
                "enum": ["http", "https"]
              },
              "bearerTokenSecret": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "key"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
